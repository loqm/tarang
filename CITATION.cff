    family-names: Tiwari
    affiliation: "Laboratory of Optics of Quantum Materials, Indian Institute of Technology Bombay"
  - given-names: Esraaj
    family-names: Sarkar Gupta
version: 0.1.5
date-released: 2026-11-04
license: MIT
repository-code: "https://github.com/loqm/tarang"
url: "https://github.com/loqm/tarang"
keywords:
  - photonics
  - integrated photonics
  - silicon nitride
  - microresonator
  - frequency comb
  - dispersion engineering
  - FDTD
  - Tidy3D
  - nested sampling
